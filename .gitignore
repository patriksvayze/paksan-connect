PAKSAN_CONNECT_SUNUM.zip
tools/ses-metni-kuyruk.json

# Android derleme çıktıları — kaynak kodu değil, `npx cap sync` ve
# derleme her seferinde yeniden üretiyor. Bu bilgisayara özel.
android/local.properties
android/.gradle
android/app/build
android/build

# Bayi APK projesi. Müşteri projesiyle aynı kural: kaynak izleniyor,
# derleme çıktısı ve bilgisayara özel SDK yolu izlenmiyor.
android-servis/local.properties
android-servis/.gradle
android-servis/app/build
android-servis/build

# Derlenmiş APK'lar — kaynak koddan yeniden üretilebilir, ikili dosya
# olduğu için git'te yalnız yer kaplar, karşılaştırma değeri yok.
# Her sürüm zaten kendi dosyasında ayrı ayrı burada duruyor.
apk/
apk-servis/
apk-bayi/

# Sunum ekran görüntüleri — tools/ekran-goruntusu.mjs ile üretiliyor.
PAKSAN_CONNECT_SUNUM/sunum/gorseller
__pycache__/

# Bu depoya ait olmayan klasörler. Aynı dizinde duruyorlar ama
# PAKSAN Connect'in kaynak kodu değiller:
#   paksan-support-dataset — kendi .git'i olan ayrı proje, 2.400+ JSON.
#     Uygulamaya yalnız üretilmiş mobile_support_package.json giriyor.
#   paksan-dijital-donusum — kendi .git'i olan sunum projesi.
#   presentation_build — sunum derleme çıktısı, 42 ikili dosya.
#   .playwright-mcp — tarayıcı aracının geçici dosyaları.
paksan-support-dataset/
paksan-dijital-donusum/
presentation_build/
.playwright-mcp/

# Sunum çalışması — üretilen .pptx ve ekran görüntüleri ikili dosya,
# git ile karşılaştırılamıyor. Brief ve rapor da tek seferlik.
sunum/

# Denetim raporu ve kayıtları — tek seferlik çıktı
denetim/

# Marketplace'ten kurulan skill'ler ve agent tanımları. Üçüncü taraf
# içerik; yeniden kurulabiliyor, depoda yer kaplamalarının anlamı yok.
# Projeye ait subagent'lar .claude/agents/ altında ve izleniyor.
.agents/
.claude/skills/
.claude/skills-pasif/
skills-lock.json

# task-observer skill'ının tuttuğu gözlem kayıtları — araç çıktısı
skill-observations/

# Veritabani ortam dosyalari: giris sifreleri icerir, git'e girmez.
# Yalniz bos ornek dosya izlenir (bkz. tools/vt/ortam.mjs).
veritabani/ortam/*.env
!veritabani/ortam/ornek.env

# Fiyat listesi yayını (sunucu-taklidi/fiyat-listesi-yayini.mjs): arşiv, yarım
# kalan yayın klasörü ve okunan PDF sunucunun verisi, depoya girmez.
sunucu-taklidi/parca-katalogu-arsiv/
sunucu-taklidi/parca-katalogu.yeni/
sunucu-taklidi/parca-katalogu/kaynak.pdf
sunucu-taklidi/parca-katalogu/katalog.json.yeni
