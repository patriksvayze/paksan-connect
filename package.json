{
  "name": "paksan-connect",
  "private": true,
  "version": "0.9.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "apk": "npm run build && node tools/cap-hedef.mjs app && npx cap sync android",
    "build:backoffice": "vite build --config vite.backoffice.config.js",
    "dogrula": "node tools/dogrula.mjs",
    "graf": "node tools/graf.mjs",
    "vt": "node tools/vt.mjs",
    "vt:tohum": "node tools/vt.mjs tohum",
    "vt:sinama": "node tools/vt.mjs sinama",
    "build:servis": "vite build --config vite.servis.config.js",
    "apk:servis": "npm run build:servis && node tools/cap-hedef.mjs servis && npx cap sync android && node tools/ikon-uret.mjs servis && node tools/cap-hedef.mjs app"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@fontsource/roboto": "^5.1.0",
    "lucide-react": "^1.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "vite": "^6.0.0"
  }
}
