# ==========================================================================
# PAKSAN veritabanı ortam dosyası — ÖRNEK
#
# Bu dosyayı kopyalayın: veritabani/ortam/yerel.env (ya da sinama.env).
# Kopyalar git'e girmez. VPS'te dosyayı depo dışında tutun ve
# "npm run vt -- kur --ayar /yol/canli.env" ile verin.
#
# Şifre satırları boş bırakılırsa "vt kur" güçlü şifre üretip buraya yazar
# ve ekrana basmaz.
# ==========================================================================

# yerel | sinama | test | canli
PAKSAN_VT_ORTAM=yerel

# yerel → Paksan_Yerel · sinama → Paksan_Sinama1 · test → Paksan_Test · canli → Paksan_Canli
PAKSAN_VT_VERITABANI=Paksan_Yerel

# SQL Server adresi (sqlcmd biçimi)
PAKSAN_VT_SUNUCU=tcp:127.0.0.1,1433

# Veritabanını ve girişleri AÇAN sunucu yöneticisi.
# windows: bu bilgisayardaki Windows hesabı (yerel). sql: aşağıdaki kullanıcı (VPS).
PAKSAN_VT_KURULUM_GIRIS=windows
PAKSAN_VT_KURULUM_KULLANICI=
PAKSAN_VT_KURULUM_SIFRE=

# Ortamın dört girişi (adları koddan gelir: paksan_<ortam>_sahip, _uygulama, _yonetici, _rapor)
PAKSAN_VT_SAHIP_SIFRE=
PAKSAN_VT_UYGULAMA_SIFRE=
PAKSAN_VT_YONETICI_SIFRE=
PAKSAN_VT_RAPOR_SIFRE=

# Boşsa bilinen yerlerde aranır
PAKSAN_VT_SQLCMD=
